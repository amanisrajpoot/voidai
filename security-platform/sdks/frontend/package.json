{
  "name": "@security-platform/frontend-sdk",
  "version": "0.1.0",
  "description": "Security Platform Frontend SDK with session replay and telemetry",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.esm.js",
  "browser": "dist/index.umd.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm,umd --dts",
